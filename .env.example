# Copy to .env and adjust as needed. Never commit .env.

# ── Database ─────────────────────────────────────────────────────────
POSTGRES_USER=spd
POSTGRES_PASSWORD=spd
POSTGRES_DB=spd_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://spd:spd@localhost:5432/spd_dev

# ── Auth ─────────────────────────────────────────────────────────────
# Must be >= 32 chars; the dev default is rejected when ENVIRONMENT=production.
JWT_SECRET=change-me-to-a-random-32-plus-char-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14

# ── App ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
